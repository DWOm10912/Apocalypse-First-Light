 (src/main/blockbench/player_actions/medical_bandage_wrap.bbmodel). The left forearm comes out in front of the chest (FK clip keys, the chest turned 20 deg toward it); the right hand brings the roll (player_props/bandage, its axis point kept on the forearm's middle line, so between keys it swings round the forearm) to the forearm's inner top and presses the loose end on (0.45-0.6 s), then three turns of 0.83 s from 0.6 to 3.1 s with BandageWrapRenderer's band (each: let go at the inner top, the roll goes over and down the far side and under on its own, the hand takes it under the forearm and brings it up the inner side); the end is laid on (3.1-3.3 s), the roll is put away and the palm presses the wrap twice (3.3-3.75 s); both arms come down from 3.75 s. docs/gameplay/survival_health_v1a.md 7","props":{"bandage":{"segments":[{"at":0,"frame":"chest","point":"pinch","hidden":false},{"at":0,"frame":"chest","point":"axis","hidden":false},{"at":3.25,"frame":"chest","point":"pinch","hidden":true}]}},"hands":{"right":[{"at":0,"target":"prop:bandage:pinch","blend":0,"roll":0,"pole":[-0.6,1,0.4]},{"at":0.6,"target":"pose","blend":0.1,"roll":0,"pole":[-0.6,1,0.4]},{"at":1,"target":"prop:bandage:pinch","blend":0.1,"roll":0,"pole":[-0.6,1,0.4]},{"at":1.4333,"target":"pose","blend":0.1,"roll":0,"pole":[-0.6,1,0.4]},{"at":1.8333,"target":"prop:bandage:pinch","blend":0.1,"roll":0,"pole":[-0.6,1,0.4]},{"at":2.2667,"target":"pose","blend":0.1,"roll":0,"pole":[-0.6,1,0.4]},{"at":2.6667,"target":"prop:bandage:pinch","blend":0.1,"roll":0,"pole":[-0.6,1,0.4]},{"at":3.75,"target":"pose","blend":0.25,"roll":0,"pole":[-0.6,1,0.4]}],"left":[]},"extra":{"events":[],"check":{"use_ticks":80},"first_person_pitch":65}},"animators":{"a5713ed8-e82e-6c0b-2f8c-0fd28249b97f":{"name":"root","type":"bone","rotation_global":false,"quaternion_interpolation":false},"110e2203-f205-19bd-a62b-0351191bd725":{"name":"pelvis","type":"bone","rotation_global":false,"quaternion_interpolation":false},"4c4cffea-1b03