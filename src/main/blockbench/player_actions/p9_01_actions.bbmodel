v/first_person_gun_view_v1_design.md 4.5): both hands on the gun before the lower chest, the arms angled down to it, the muzzle ahead and 23 degrees down. Keyed in the chest frame: it turns and bends with the chest, not with the look. Third person and the own body only: the own first person shows the gun through its old view model. A shot, aiming, a reload or an inspect raise it (no hip_fire). Weight (1 - raise)(1 - sprint). Keyed in the AFL Rig Blockbench plugin.","props":{"p9_01":{"segments":[{"at":0,"frame":"chest","point":"grip_r","hidden":false}]}},"hands":{"right":[{"at":0,"target":"prop:p9_01:grip_r","blend":0,"roll":0,"pole":[-0.27,0.89,0.37]}],"left":[{"at":0,"target":"prop:p9_01:grip_l","blend":0,"roll":0,"pole":[0.26,0.95,0.16]}]},"extra":{"events":[]}},"animators":{"a418d87e-a84f-b37e-9099-4f8bf1b53e05":{"name":"root","type":"bone","rotation_global":false,"quaternion_interpolation":false},"a913803d-2b1e-92e4-2452-cd6c7f2c9ad0":{"name":"pelvis","type":"bone","rotation_global":false,"quaternion_interpolation":false},"a928d152-b4d4-9500-6725-b47239354aaf":{"name":"chest","type":"bone","rotation_global":false,"quaternion_interpolation":false},"5f15494e-ed01-8be7-5c6e-7bf1239d18ee":{"name":"head","type":"bone","rotation_global":false,"quaternion_interpolation":false},"8ea14c30-8374-b179-b826-51ee0d310137":{"name":"upper_arm_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"9338c40a-f483-9435-c84d-f1e1c29b7162":{"name":"forearm_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"2572dde8-9ef4-9eb0-794a-9a01e86c5912":{"name":"hand_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"eb841638-3487-7afa-68b4-66355c3c7d30":{"name":"upper_arm_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"e7624e89-04c9-5526-bd97-bf0948929eb6":{"name":"forearm_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"75b41c2b-2134-7111-9547-d0f2a0d2f909":{"name":"h