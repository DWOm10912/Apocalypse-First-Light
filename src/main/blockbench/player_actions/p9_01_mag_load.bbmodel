iew_pitch":null,"chest_twist":0,"about":"Loading a P9-01 magazine by hand (weapon/NativeMagazineLoading; client/skeleton/SkeletonActions plays it from the loading tag on the held magazine, docs/native_guns/magazine_system_v1.md 4): a 1 s loop, one round each. The left hand holds the magazine before the upper chest, lips up and tipped back, its front turned left (chest frame); the right hand takes a round from the right front of the hips (hidden until 0.30 s), brings it over the lips tip up and presses it in, base down and back, at 0.65 s (NativeMagazineLoading PRESS_TICK 13: the round goes into the magazine then, so the prop hides and the magazine draws it), the thumb resting on the lips until the next. Upper body only, so the player walks while loading. Keyed in the AFL Rig Blockbench plugin (src/main/blockbench/player_actions/p9_01_mag_load.bbmodel).","props":{"9x19mm_round":{"segments":[{"at":0,"frame":"prop:p9_01_magazine","point":"pinch","hidden":true},{"at":0.08,"frame":"bone:pelvis","point":"pinch","hidden":true},{"at":0.3,"frame":"bone:pelvis","point":"pinch","hidden":false},{"at":0.36,"frame":"prop:p9_01_magazine","point":"pinch","hidden":false},{"at":0.65,"frame":"prop:p9_01_magazine","point":"pinch","hidden":true}]},"p9_01_magazine":{"segments":[{"at":0,"frame":"chest","point":"grip","hidden":false}]}},"hands":{"right":[{"at":0,"target":"prop:9x19mm_round:pinch","blend":0,"roll":0}],"left":[{"at":0,"target":"prop:p9_01_magazine:hold_l","blend":0,"roll":0}]},"extra":{}},"animators":{"1a96b9f7-d7bc-3e39-a9c9-e51ba68d29c2":{"name":"root","type":"bone","rotation_global":false,"quaternion_interpolation":false},"e0961045-7975-5bb0-c238-556a0cb5356d":{"name":"pelvis","type":"bone","rotation_global":false,"quaternion_interpolation":false},"7a48d783-a3a2-d51b-3e14-daaf804cf90a":{"name":"chest","type":"bone","rotation_global":false,"quaternion_interpolation":false},"3baa103e-ae50-1b59-9817-1478426caaa9":{"name":"head","type":"bone","rotation_global":false,"quaterni