{
  "multipart": [
    {
      "when": {
        "horizontal_axis": "x"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/diagonal_brace_a_xy"
      }
    },
    {
      "when": {
        "horizontal_axis": "z"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/diagonal_brace_a_zy"
      }
    },
    {
      "when": {
        "horizontal_axis": "x",
        "joint_negative": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/a_negative_xy_joint"
      }
    },
    {
      "when": {
        "horizontal_axis": "x",
        "joint_positive": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/a_positive_xy_joint"
      }
    },
    {
      "when": {
        "horizontal_axis": "z",
        "joint_negative": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/a_negative_zy_joint"
      }
    },
    {
      "when": {
        "horizontal_axis": "z",
        "joint_positive": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/a_positive_zy_joint"
      }
    }
  ]
}
