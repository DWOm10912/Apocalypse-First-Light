{
  "multipart": [
    {
      "apply": {
        "model": "apocalypse_firstlight:block/underground_fuel_tank/cell"
      }
    },
    {
      "when": {
        "axis": "z",
        "flipped": "false",
        "along": "3",
        "across": "1",
        "level": "2"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/underground_fuel_tank/diesel"
      }
    },
    {
      "when": {
        "axis": "x",
        "flipped": "false",
        "along": "3",
        "across": "1",
        "level": "2"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/underground_fuel_tank/diesel",
        "y": 270
      }
    },
    {
      "when": {
        "axis": "z",
        "flipped": "true",
        "along": "3",
        "across": "1",
        "level": "2"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/underground_fuel_tank/diesel",
        "y": 180
      }
    },
    {
      "when": {
        "axis": "x",
        "flipped": "true",
        "along": "3",
        "across": "1",
        "level": "2"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/underground_fuel_tank/diesel",
        "y": 90
      }
    }
  ]
}
