{
  "multipart": [
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/town/coping_base"
      }
    },
    {
      "when": {
        "axis": "x",
        "left": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/town/coping_end"
      }
    },
    {
      "when": {
        "axis": "x",
        "right": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/town/coping_end",
        "y": 180
      }
    },
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/town/coping_base",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "left": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/town/coping_end",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "right": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/town/coping_end",
        "y": 270
      }
    },
    {
      "when": {
        "flue": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/town/coping_flue"
      }
    }
  ]
}
