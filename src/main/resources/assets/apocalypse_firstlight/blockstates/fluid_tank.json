{
  "multipart": [
    {
      "apply": {
        "model": "apocalypse_firstlight:block/fluid_tank_body"
      }
    },
    {
      "when": {
        "has_tank_above": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/fluid_tank_join_top"
      }
    },
    {
      "when": {
        "has_tank_above": "false"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/fluid_tank_port_idle"
      }
    },
    {
      "when": {
        "has_tank_below": "true"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/fluid_tank_join_bottom"
      }
    },
    {
      "when": {
        "has_tank_below": "false"
      },
      "apply": {
        "model": "apocalypse_firstlight:block/fluid_tank_port_idle",
        "x": 180
      }
    }
  ]
}
